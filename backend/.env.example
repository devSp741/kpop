PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kpop_radar
DB_PORT=3306

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Social API Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Spotify Web API Credentials (Get free from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Meta & Instagram Webhook Configuration
META_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Development Sync Switch (Set to false during dev to pause all outbound requests to social media)
ENABLE_BACKGROUND_SYNC=true
